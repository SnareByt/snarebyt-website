# ============================================================
#  SnareByt — server environment
#  NEVER commit the real .env. NEVER prefix any of these with
#  NEXT_PUBLIC_ — that would ship them to the browser.
# ============================================================

# Neon / Supabase Postgres connection string
DATABASE_URL="postgresql://user:pass@host/snarebyt?sslmode=require"

# Session signing. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# First admin account, created by the seed
ADMIN_EMAIL="snarebyt@gmail.com"
ADMIN_PASSWORD=""

# ---------- SSLCOMMERZ ----------
# Sandbox credentials from developer.sslcommerz.com/registration
SSLC_STORE_ID=""
SSLC_STORE_PASSWORD=""
SSLC_SANDBOX="true"

# ---------- Cloudflare R2 ----------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_PRIVATE="snarebyt-private"
R2_BUCKET_PUBLIC="snarebyt-public"
R2_PUBLIC_BASE_URL="https://cdn.snarebyt.com"

# ---------- Resend ----------
RESEND_API_KEY=""
MAIL_FROM="SnareByt <no-reply@snarebyt.com>"

# Public site origin, used in emails and payment callbacks
APP_URL="http://localhost:3000"

# Indexing is OFF until this is exactly "true". Keep it unset while the site
# runs on a *.vercel.app URL so the preview never reaches a search index.
SITE_LIVE="false"
