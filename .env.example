# ============================================================
#  SnareByt — server environment
#  NEVER commit the real .env. NEVER prefix any of these with
#  NEXT_PUBLIC_ — that would ship them to the browser.
# ============================================================

# Neon / Supabase Postgres connection string
DATABASE_URL="postgresql://user:pass@host/snarebyt?sslmode=require"

# Session signing. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# First admin account, created by the seed
ADMIN_EMAIL="snarebyt@gmail.com"
ADMIN_PASSWORD=""

# ---------- SSLCOMMERZ ----------
# Sandbox credentials from developer.sslcommerz.com/registration
SSLC_STORE_ID=""
SSLC_STORE_PASSWORD=""
SSLC_SANDBOX="true"

# ---------- Cloudflare R2 ----------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_PRIVATE="snarebyt-private"
R2_BUCKET_PUBLIC="snarebyt-public"
R2_PUBLIC_BASE_URL="https://cdn.snarebyt.com"

# ---------- Resend ----------
RESEND_API_KEY=""
MAIL_FROM="SnareByt <no-reply@snarebyt.com>"

# Public site origin, used in emails and payment callbacks
APP_URL="http://localhost:3000"

# Indexing is OFF until this is exactly "true". Keep it unset while the site
# runs on a *.vercel.app URL so the preview never reaches a search index.
SITE_LIVE="false"

# ---------- Phone dashboard (/app) ----------
# Push alerts for new orders, payments and bookings.
#
# Generate the pair once with:
#     npx web-push generate-vapid-keys
#
# The PUBLIC key is sent to the browser — that is what it is for, and it is
# useless without the private half. The PRIVATE key must never be prefixed
# NEXT_PUBLIC_ and never appears in any page.
#
# Leave these empty and the app still works completely; the Alerts screen just
# says push is not configured, and email alerts carry on as before.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A mailto: or https: URL identifying you to the push service, per RFC 8292.
VAPID_SUBJECT="mailto:snarebyt@gmail.com"

# Optional. The domain Face ID credentials are welded to.
#
# Leave this UNSET unless you need to override it. When it is empty the server
# uses the host of the actual request, which is correct here because APP_URL is
# deliberately unset in production (the site answers on snarebyt.com,
# www.snarebyt.com and a *.vercel.app address).
#
# A passkey is bound to the exact hostname it was created on: one enrolled on
# www.snarebyt.com will NOT unlock snarebyt.com. Always install the app from
# the same address. Setting this to your canonical apex domain pins that.
WEBAUTHN_RP_ID=""

# ---------- Admin privacy (optional) ----------
# Moves the admin sign-in page to /admin/<this value>.
#
# Leave it unset and the sign-in page stays at /admin/login, exactly as
# before. Set it and /admin/login answers 404 like every other admin URL,
# so the panel has no discoverable front door at all.
#
# Lowercase letters, numbers and hyphens, 3-64 characters. Anything else is
# ignored and /admin/login keeps working — a half-applied secret would be a
# lockout, so it fails back to the door that is known to work.
#
# Set it in Vercel, not here, and it can always be read back from the Vercel
# dashboard if forgotten.
# ADMIN_SECRET_PATH="pick-something-only-you-know"
